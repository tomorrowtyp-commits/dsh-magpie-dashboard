{
  "name": "dsh-magpie-dashboard",
  "version": "0.3.2-local.0",
  "description": "Magpie-bound multi-account quota dashboard for DSH",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "engines": { "node": ">=22" },
  "license": "MIT",
  "files": ["lib/**", "cordis.patch.yml", "README.md"]
}
